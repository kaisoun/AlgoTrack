<?xml version="1.0" encoding="utf-8"?>
<Application>
  <ActionDesign>
    <Actions>
      <Action Id="Save" Shortcut="Enter" NullValuePrompt="Control+Shift+S" />
    </Actions>
  </ActionDesign>
  <NavigationItems NavigationStyle="Accordion">
    <Items>
      <Item Id="Default" Caption="Général" Index="0" />
      <Item Id="Bases" Index="1" />
      <Item Id="Track" Index="2" />
      <Item Id="Ventes" Index="3" />
      <Item Id="Reports" Index="5" />
      <Item Id="State Machine" Removed="True" />
    </Items>
  </NavigationItems>
  <Options UIType="TabbedMDI" FormStyle="Ribbon" RestoreTabbedMdiLayout="True" ShowTabImage="True" VirtualScrollingEnabled="True" />
  <SchemaModules>
    <SchemaModule Name="CloneObjectModule" Version="26.1.3.0" IsNewNode="True" />
    <SchemaModule Name="SchedulerBlazorModule" Version="26.1.3.0" IsNewNode="True" />
    <SchemaModule Name="SchedulerModuleBase" Version="26.1.3.0" IsNewNode="True" />
    <SchemaModule Name="SystemModule" Version="26.1.3.0" IsNewNode="True" />
  </SchemaModules>
</Application>